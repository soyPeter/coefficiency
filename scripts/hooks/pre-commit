#!/bin/bash
# scripts/hooks/pre-commit
# Smart blocking gates before commit.
#
# Gates:
# 1. Commit message format — strict conventional commits
# 2. Build gate — skip for docs-only commits
# 3. Backbone version bump — required when backbone files change
# 4. WIP task check — warn if WIP tasks remain
#
# Exit 0 = allow commit
# Exit 1 = block commit

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

ERRORS=0
WARNINGS=0

PROJECT_ROOT="$(git rev-parse --show-toplevel)"

# ── Gate 1: Commit Message Format ───────────────────────────────────────────
# Strict conventional commits: type(scope): description
# Valid types: feat, fix, docs, refactor, test, chore, perf, ci, build

COMMIT_MSG_FILE="$1"
if [ -n "$COMMIT_MSG_FILE" ] && [ -f "$COMMIT_MSG_FILE" ]; then
    COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE")
    
    # Skip merge commits and comments
    if [[ "$COMMIT_MSG" =~ ^Merge\  ]] || [[ "$COMMIT_MSG" =~ ^# ]]; then
        : # Allow
    elif ! echo "$COMMIT_MSG" | grep -qE '^(feat|fix|docs|refactor|test|chore|perf|ci|build)(\([a-z0-9_-]+\))?: .{10,}$'; then
        echo -e "${RED}❌ Commit message format invalid${NC}"
        echo "   Expected: type(scope): description (min 10 chars)"
        echo "   Valid types: feat, fix, docs, refactor, test, chore, perf, ci, build"
        echo "   Got:      $COMMIT_MSG"
        echo ""
        echo "   Examples:"
        echo "     feat(portal): add worktree status dashboard"
        echo "     fix(quarkus): resolve NPE in health check endpoint"
        echo "     docs(backbone): update 3-TASKS.md with M3 progress"
        echo ""
        ERRORS=$((ERRORS + 1))
    fi
fi

# ── Gate 2: Smart Build Gate ──────────────────────────────────────────────
# Skip build if only docs files changed.
# Run build if any source file changed.

STAGED_FILES=$(git diff --name-only --cached 2>/dev/null || true)
SOURCE_CHANGED=""
DOCS_CHANGED=""

if [ -n "$STAGED_FILES" ]; then
    SOURCE_CHANGED=$(echo "$STAGED_FILES" | grep -E '\.(java|kt|go|py|js|ts|tsx|astro|gradle|kts|properties|yaml|yml|json|sh)$' || true)
    DOCS_CHANGED=$(echo "$STAGED_FILES" | grep -E '\.(md|txt|rst)$' || true)
fi

if [ "${SKIP_BUILD:-0}" = "1" ]; then
    echo -e "${YELLOW}⚠️  Skipping build gate (SKIP_BUILD=1)${NC}"
elif [ -z "$SOURCE_CHANGED" ] && [ -n "$DOCS_CHANGED" ]; then
    echo -e "${GREEN}✅ Docs-only commit — skipping build gate${NC}"
elif [ -z "$SOURCE_CHANGED" ] && [ -z "$DOCS_CHANGED" ]; then
    echo -e "${YELLOW}⚠️  No source or docs files staged — skipping build gate${NC}"
elif [ ! -f "$PROJECT_ROOT/gradlew" ] && [ ! -f "$PROJECT_ROOT/package.json" ]; then
    echo -e "${YELLOW}⚠️  No build tool detected — skipping build gate${NC}"
else
    echo "🔨 Running build gate..."
    BUILD_PASSED=true
    
    # Gradle build
    if [ -f "$PROJECT_ROOT/gradlew" ]; then
        if ! ./gradlew build -x test -q --daemon 2>&1 | tail -20; then
            BUILD_PASSED=false
        fi
    fi
    
    # Node build
    if [ -f "$PROJECT_ROOT/package.json" ] && [ -d "$PROJECT_ROOT/dev-portal" ]; then
        if ! (cd "$PROJECT_ROOT/dev-portal" && npm run build 2>&1 | tail -20); then
            BUILD_PASSED=false
        fi
    fi
    
    if [ "$BUILD_PASSED" = true ]; then
        echo -e "${GREEN}✅ Build gate passed${NC}"
    else
        echo -e "${RED}❌ Build gate FAILED — fix errors before committing${NC}"
        ERRORS=$((ERRORS + 1))
    fi
fi

# ── Gate 3: Backbone Version Bump ─────────────────────────────────────────
# If backbone/ files changed (except 3-TASKS.md, 6-MEMORY.md), VERSION must be updated.
# NOTE: Only enforced in the generator project (has dev-portal/ and templates/backbone/).
# Generated projects should NOT bump VERSION — it tracks the template version they were born from.

VERSION_FILE="$PROJECT_ROOT/backbone/VERSION"
if [ -f "$VERSION_FILE" ] && [ -d "$PROJECT_ROOT/dev-portal" ] && [ -d "$PROJECT_ROOT/templates/backbone" ]; then
    # Check for backbone file changes (excluding task/memory updates)
    BACKBONE_CHANGED=$(echo "$STAGED_FILES" | grep -E '^backbone/' | grep -vE '3-TASKS\.md|6-MEMORY\.md|planning/STATE\.md' || true)
    
    if [ -n "$BACKBONE_CHANGED" ]; then
        VERSION_STAGED=$(echo "$STAGED_FILES" | grep -E '^backbone/VERSION$' || true)
        
        if [ -z "$VERSION_STAGED" ]; then
            echo -e "${RED}❌ Backbone files changed but backbone/VERSION not updated${NC}"
            echo "   Changed files:"
            echo "$BACKBONE_CHANGED" | sed 's/^/     /'
            echo ""
            echo "   Update backbone/VERSION with today's date (YYYY.MM.DD)"
            echo "   Format: CalVer — e.g., $(date +%Y.%m.%d)"
            echo "   Then: git add backbone/VERSION && git commit"
            echo ""
            ERRORS=$((ERRORS + 1))
        fi
    fi
fi

# ── Gate 4: Worktrunk Enforcement ─────────────────────────────────────────
# BLOCK feature commits on protected branches without worktree

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
GIT_DIR=$(git rev-parse --git-dir 2>/dev/null || true)

SKIP_WORKTRUNK="${SKIP_WORKTRUNK:-${CLAUDE_CODE_SKIP_WORKTRUNK:-0}}"
if [ "$SKIP_WORKTRUNK" != "1" ] && [[ "$CURRENT_BRANCH" =~ ^(main|master|dev|develop)$ ]] && [[ "$GIT_DIR" != *"worktrees"* ]]; then
    TASKS_FILE="$PROJECT_ROOT/backbone/3-TASKS.md"
    if [ -f "$TASKS_FILE" ]; then
        FIX_KEYWORDS="fix|bug|docs|update|refactor|clean|remove|chore|test|style|perf|ci|build|revert"
        WIP_TASKS=$(grep -E '^\s*-\s*\[WIP\]' "$TASKS_FILE" 2>/dev/null || true)
        
        if [ -n "$WIP_TASKS" ]; then
            FEATURE_WORK=""
            while IFS= read -r line; do
                TASK_TEXT=$(echo "$line" | sed 's/.*\[WIP\]\s*//' | tr '[:upper:]' '[:lower:]')
                if ! echo "$TASK_TEXT" | grep -qiE "^\s*-?\s*($FIX_KEYWORDS)"; then
                    FEATURE_WORK="$line"
                    break
                fi
            done <<< "$WIP_TASKS"
            
            if [ -n "$FEATURE_WORK" ]; then
                echo -e "${RED}❌ WORKTRUNK VIOLATION: Feature work on protected branch${NC}"
                echo "   Branch: $CURRENT_BRANCH"
                echo "   WIP task: $FEATURE_WORK"
                echo ""
                echo "   Agentic Backbone requires feature work in isolated worktrees."
                echo ""
                echo "   Create worktree:"
                echo "      ./scripts/worktrunk.sh create <feature-name>"
                echo ""
                echo "   Or if this is a fix/refactor, update 3-TASKS.md to use:"
                echo "      [WIP] fix: ... or [WIP] refactor: ..."
                echo ""
                ERRORS=$((ERRORS + 1))
            fi
        fi
    fi
fi

# ── Gate 5: WIP Task Check ────────────────────────────────────────────────
# Warn if WIP tasks remain (non-blocking)

TASKS_FILE="$PROJECT_ROOT/backbone/3-TASKS.md"
if [ -f "$TASKS_FILE" ]; then
    # Only match actual task lines: start with '- [WIP]' (not instruction text)
    WIP_TASKS=$(grep -E '^\s*-\s*\[WIP\]' "$TASKS_FILE" 2>/dev/null || true)
    WIP_COUNT=$(echo "$WIP_TASKS" | grep -c '^' || true)
    if [ "$WIP_COUNT" -gt 0 ] && [ -n "$WIP_TASKS" ]; then
        echo -e "${YELLOW}⚠️  $WIP_COUNT WIP task(s) still open in backbone/3-TASKS.md${NC}"
        echo "$WIP_TASKS" | head -3 | sed 's/^/   /'
        echo "   Mark tasks [x] and update 5-DECISIONS.md / 6-MEMORY.md before committing."
        WARNINGS=$((WARNINGS + 1))
    fi
fi

# ── Gate 6: Security Fix Hygiene ──────────────────────────────────────────
# BLOCK commits that expose vulnerability details in public artifacts

SECURITY_KEYWORDS="sql.injection|sql-injection|xss|ssrf|csrf|dos|ddos|rce|buffer.overflow|buffer-overflow|heap.overflow|heap-overflow|use.after.free|use-after-free|path.traversal|path-traversal|command.injection|command-injection|ldap.injection|ldap-injection|xml.external.entity|xxe|prototype.pollution|prototype-pollution|insecure.deserialization|insecure-deserialization|unrestricted.file.upload|unrestricted-file-upload|authentication.bypass|authentication-bypass|authorization.bypass|authorization-bypass|privilege.escalation|privilege-escalation|man.in.the.middle|man-in-the-middle|credential.exposure|credential-exposure|hardcoded.credentials|hardcoded-credentials|sensitive.data.exposure|sensitive-data-exposure|insufficient.logging|insufficient-logging|security.misconfiguration|security-misconfiguration|missing.authentication|missing-authentication|missing.authorization|missing-authorization|broken.access.control|broken-access-control|cryptographic.failure|cryptographic-failure|integrity.failure|integrity-failure|availability.failure|availability-failure|information.disclosure|information-disclosure"

# Check commit message for security keywords
if [ -n "$COMMIT_MSG_FILE" ] && [ -f "$COMMIT_MSG_FILE" ]; then
    COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE")
    if echo "$COMMIT_MSG" | grep -qiE "($SECURITY_KEYWORDS)"; then
        echo -e "${RED}❌ SECURITY DISCLOSURE: Commit message contains vulnerability keywords${NC}"
        echo "   Commit: $COMMIT_MSG"
        echo ""
        echo "   Attackers monitor public repos for vulnerability signals."
        echo "   NEVER name attack types in public artifacts."
        echo ""
        echo "   GOOD examples:"
        echo "     'fix: add input validation'"
        echo "     'fix: validate outgoing URLs'"
        echo "     'fix: sanitize query parameters'"
        echo ""
        echo "   See: backbone/skills/general/security-fixes/SKILL.md"
        echo ""
        ERRORS=$((ERRORS + 1))
    fi
fi

# Check branch name for security keywords
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
if echo "$BRANCH_NAME" | grep -qiE "($SECURITY_KEYWORDS)"; then
    echo -e "${RED}❌ SECURITY DISCLOSURE: Branch name contains vulnerability keywords${NC}"
    echo "   Branch: $BRANCH_NAME"
    echo ""
    echo "   Branch names are public. Use neutral language:"
    echo "     'improve-input-validation' instead of 'fix-sql-injection'"
    echo ""
    echo "   See: backbone/skills/general/security-fixes/SKILL.md"
    echo ""
    ERRORS=$((ERRORS + 1))
fi

# ── Gate 7: Skill Quality Lint ────────────────────────────────────────────
# Validate new or modified SKILL.md files

STAGED_SKILLS=$(echo "$STAGED_FILES" | grep -E 'SKILL\.md$' || true)
if [ -n "$STAGED_SKILLS" ]; then
    echo "🔍 Linting staged SKILL.md files..."
    
    while IFS= read -r skill_file; do
        [ -z "$skill_file" ] && continue
        
        SKILL_PATH="$PROJECT_ROOT/$skill_file"
        if [ ! -f "$SKILL_PATH" ]; then
            continue
        fi
        
        SKILL_ERRORS=0
        
        # Check frontmatter
        if ! head -5 "$SKILL_PATH" | grep -q '^---$'; then
            echo -e "   ${RED}✗ $skill_file: Missing frontmatter (---)${NC}"
            SKILL_ERRORS=$((SKILL_ERRORS + 1))
        fi
        
        # Check name field
        if ! grep -q '^name:' "$SKILL_PATH"; then
            echo -e "   ${RED}✗ $skill_file: Missing 'name' in frontmatter${NC}"
            SKILL_ERRORS=$((SKILL_ERRORS + 1))
        fi
        
        # Check description field
        if ! grep -q '^description:' "$SKILL_PATH"; then
            echo -e "   ${RED}✗ $skill_file: Missing 'description' in frontmatter${NC}"
            SKILL_ERRORS=$((SKILL_ERRORS + 1))
        fi
        
        # Check framework field
        if ! grep -q '^framework:' "$SKILL_PATH"; then
            echo -e "   ${RED}✗ $skill_file: Missing 'framework' in frontmatter${NC}"
            SKILL_ERRORS=$((SKILL_ERRORS + 1))
        fi
        
        # Check size (should be under 300 lines for SKILL.md)
        LINE_COUNT=$(wc -l < "$SKILL_PATH")
        if [ "$LINE_COUNT" -gt 300 ]; then
            echo -e "   ${YELLOW}⚠ $skill_file: $LINE_COUNT lines (recommended < 300)${NC}"
            echo "     Consider splitting details into reference.md"
            WARNINGS=$((WARNINGS + 1))
        fi
        
        # Check description quality (third person)
        DESC_LINE=$(grep -A 2 '^description:' "$SKILL_PATH" | tr '\n' ' ')
        if echo "$DESC_LINE" | grep -qiE '^description:\s*(I can|I will|I am|I help)'; then
            echo -e "   ${YELLOW}⚠ $skill_file: Description uses first person ('I...')${NC}"
            echo "     Use third person: 'Generates...' not 'I generate...'"
            WARNINGS=$((WARNINGS + 1))
        fi
        
        if [ "$SKILL_ERRORS" -gt 0 ]; then
            ERRORS=$((ERRORS + SKILL_ERRORS))
        else
            echo -e "   ${GREEN}✓ $skill_file${NC}"
        fi
    done <<< "$STAGED_SKILLS"
    
    if [ "$ERRORS" -gt 0 ]; then
        echo ""
        echo "   See: backbone/skills/general/create-skill/SKILL.md"
        echo ""
    fi
fi

# ── Gate 8: Traceability Gate (I→V) ────────────────────────────────────────
# If requirements or code changed, verify traceability matrix is valid

if [ -z "${SKIP_TRACEABILITY:-}" ] && [ -x "$PROJECT_ROOT/scripts/hooks/pre-commit-traceability-gate.sh" ]; then
    if ! bash "$PROJECT_ROOT/scripts/hooks/pre-commit-traceability-gate.sh" > /tmp/trace-gate.out 2>&1; then
        cat /tmp/trace-gate.out
        ERRORS=$((ERRORS + 1))
    fi
fi

# ── Gate 9: EARS Validation ───────────────────────────────────────────────
# Validate EARS syntax in staged PRD files

if [ -z "${SKIP_EARS_CHECK:-}" ] && [ -x "$PROJECT_ROOT/scripts/hooks/pre-commit-ears-check.sh" ]; then
    if ! bash "$PROJECT_ROOT/scripts/hooks/pre-commit-ears-check.sh" > /tmp/ears-check.out 2>&1; then
        cat /tmp/ears-check.out
        ERRORS=$((ERRORS + 1))
    fi
fi

# ── Gate 10: QMS Advisory (CAPA past-due check) ───────────────────────────
# Warns if any CAPA is past due. Advisory only — does not block.

if [ -z "${SKIP_QMS_CHECK:-}" ] && [ -x "$PROJECT_ROOT/scripts/hooks/pre-commit-qms.sh" ]; then
    echo "🔍 Gate 10: QMS check..."
    bash "$PROJECT_ROOT/scripts/hooks/pre-commit-qms.sh"
fi

# ── Gate 10a: QMS NCR→CAPA Pairing ─────────────────────────────────────
# Warn if any open NCR has no corresponding CAPA (mandatory pairing)

if [ -z "${SKIP_QMS_CHECK:-}" ]; then
    NCR_DIR="$PROJECT_ROOT/backbone/artifacts/qms/ncr"
    CAPA_DIR="$PROJECT_ROOT/backbone/artifacts/qms/capa"
    if [ -d "$NCR_DIR" ]; then
        for ncr_file in "$NCR_DIR"/NCR-*.yml; do
            [ -f "$ncr_file" ] || continue
            ncr_id=""
            ncr_status=""
            while IFS= read -r line; do
                case "$line" in
                    id:*) ncr_id="${line#id: }" ;;
                    status:*) ncr_status="${line#status: }" ;;
                esac
            done < "$ncr_file"
            ncr_id="${ncr_id//\"/}"
            ncr_status="${ncr_status//\"/}"

            if [ "$ncr_status" = "open" ]; then
                has_capa=false
                if [ -d "$CAPA_DIR" ]; then
                    for capa_file in "$CAPA_DIR"/CAPA-*.yml; do
                        [ -f "$capa_file" ] || continue
                        if grep -q "$ncr_id" "$capa_file" 2>/dev/null; then
                            has_capa=true
                            break
                        fi
                    done
                fi
                if [ "$has_capa" = false ]; then
                    echo -e "${YELLOW}⚠️  QMS: $ncr_id has no linked CAPA (mandatory pairing)${NC}"
                    echo -e "${YELLOW}   Create one: ./scripts/qms-capa-create.sh --ncr $ncr_id${NC}"
                fi
            fi
        done
    fi
fi

# ── Gate 11: Task Completion Acceptance Criteria ────────────────────────────
# Validate that newly-[x] tasks have acceptance criteria met

if [ -z "${SKIP_TASK_COMPLETION:-}" ] && [ -f "$PROJECT_ROOT/scripts/lib/task-acceptance-check.sh" ]; then
    source "$PROJECT_ROOT/scripts/lib/task-acceptance-check.sh"

    # Check if 3-TASKS.md is in staged changes
    if echo "$STAGED_FILES" | grep -qE '^backbone/3-TASKS\.md$'; then
        TASKS_DIFF=$(git diff --cached -- backbone/3-TASKS.md 2>/dev/null || true)
        if [ -n "$TASKS_DIFF" ]; then
            echo "🔍 Gate 11: Checking task completion acceptance criteria..."
            if ! check_staged_tasks_completion "$PROJECT_ROOT" "$TASKS_DIFF" > /tmp/task-completion.out 2>&1; then
                cat /tmp/task-completion.out
                ERRORS=$((ERRORS + 1))
            else
                echo -e "${GREEN}✅ Task completion criteria check passed${NC}"
            fi
        fi
    fi
fi

# ── Gate 12: Task Granularity Validator (P→T) ────────────────────────────
# Validate that newly-added [WIP] tasks are granular and have planning docs

if [ -z "${SKIP_GRANULARITY:-}" ] && [ -x "$PROJECT_ROOT/scripts/hooks/pre-tool-use-task-granularity-check.sh" ]; then
    if echo "$STAGED_FILES" | grep -qE '^backbone/3-TASKS\.md$'; then
        TASKS_DIFF=$(git diff --cached -- backbone/3-TASKS.md 2>/dev/null || true)
        if [ -n "$TASKS_DIFF" ]; then
            echo "🔍 Gate 12: Checking task granularity..."
            # Re-run the hook with the diff content as stdin
            if ! echo "$TASKS_DIFF" | bash "$PROJECT_ROOT/scripts/hooks/pre-tool-use-task-granularity-check.sh" > /tmp/granularity.out 2>&1; then
                cat /tmp/granularity.out
                ERRORS=$((ERRORS + 1))
            else
                echo -e "${GREEN}✅ Task granularity check passed${NC}"
            fi
        fi
    fi
fi

# ── Gate 13: Secret Scan ──────────────────────────────────────────────────
# Detect credentials and secrets in staged files

if [ -x "$PROJECT_ROOT/scripts/secret-scan.sh" ]; then
    echo "🔍 Running secret scan on staged files..."
    if ! bash "$PROJECT_ROOT/scripts/secret-scan.sh" --staged > /tmp/secret-scan.out 2>&1; then
        cat /tmp/secret-scan.out
        echo ""
        echo "   If these are test fixtures or false positives:"
        echo "     1. Add file to EXCLUDE_PATTERNS in scripts/secret-scan.sh"
        echo "     2. Use git commit --no-verify (not recommended)"
        echo ""
        ERRORS=$((ERRORS + 1))
    fi
fi

# ── Gate 14: Skill Acknowledgment Check (S→C) ──────────────────────────────
# Cross-agent enforcement: verify required skills are acknowledged

if [ -z "${SKIP_SKILL_CHECK:-}" ] && [ -x "$PROJECT_ROOT/scripts/hooks/pre-commit-skill-check.sh" ]; then
    echo "🔍 Gate 14: Checking skill acknowledgments..."
    if ! bash "$PROJECT_ROOT/scripts/hooks/pre-commit-skill-check.sh" > /tmp/skill-check.out 2>&1; then
        cat /tmp/skill-check.out
        ERRORS=$((ERRORS + 1))
    fi
fi

# ── Gate 15: Planning Doc Check (P→T) ─────────────────────────────────────
# Verify staged PRDs have corresponding planning documents

if [ -z "${SKIP_PLANNING_CHECK:-}" ] && [ -x "$PROJECT_ROOT/scripts/hooks/pre-commit-planning-check.sh" ]; then
    echo "🔍 Gate 15: Checking planning documents..."
    if ! bash "$PROJECT_ROOT/scripts/hooks/pre-commit-planning-check.sh" > /tmp/planning-check.out 2>&1; then
        cat /tmp/planning-check.out
        ERRORS=$((ERRORS + 1))
    fi
fi

# ── Gate 16: Grill Evidence Check (G→P) ────────────────────────────────────
# Verify staged PRDs have grill evidence

if [ -z "${SKIP_GRILL_CHECK:-}" ] && [ -x "$PROJECT_ROOT/scripts/hooks/pre-commit-grill-check.sh" ]; then
    echo "🔍 Gate 16: Checking grill evidence..."
    if ! bash "$PROJECT_ROOT/scripts/hooks/pre-commit-grill-check.sh" > /tmp/grill-check.out 2>&1; then
        cat /tmp/grill-check.out
        ERRORS=$((ERRORS + 1))
    fi
fi

# ── Gate 17: Commit Size Gate ─────────────────────────────────────────────
# Enforce incremental commits (max 10 files per commit)

if [ -z "${SKIP_COMMIT_SIZE_CHECK:-}" ] && [ -x "$PROJECT_ROOT/scripts/hooks/pre-commit-commit-size.sh" ]; then
    echo "🔍 Gate 17: Checking commit size..."
    if ! bash "$PROJECT_ROOT/scripts/hooks/pre-commit-commit-size.sh" > /tmp/commit-size.out 2>&1; then
        cat /tmp/commit-size.out
        ERRORS=$((ERRORS + 1))
    fi
fi

# ── Gate 18: Conventions Read Check (C→W) ────────────────────────────────
# Verify code commits have read framework conventions

if [ -z "${SKIP_CONVENTIONS_CHECK:-}" ] && [ -x "$PROJECT_ROOT/scripts/hooks/pre-commit-conventions-check.sh" ]; then
    echo "🔍 Gate 18: Checking conventions read..."
    if ! bash "$PROJECT_ROOT/scripts/hooks/pre-commit-conventions-check.sh" > /tmp/conventions-check.out 2>&1; then
        cat /tmp/conventions-check.out
        ERRORS=$((ERRORS + 1))
    fi
fi

# ── Gate 19: Change Folder Validation (Gates X & Y) ──────────────────────
# Validate proposal.md REQ-XXX format and tasks.md REQ traceability

if [ -z "${SKIP_CHANGE_CHECK:-}" ] && [ -x "$PROJECT_ROOT/scripts/hooks/pre-change.sh" ]; then
    echo "🔍 Gate 19: Checking change folder structure..."
    if ! bash "$PROJECT_ROOT/scripts/hooks/pre-change.sh" > /tmp/change-check.out 2>&1; then
        cat /tmp/change-check.out
        ERRORS=$((ERRORS + 1))
    fi
fi

# ── Gate 20: Regenerate Agent Context Artifacts ────────────────────────────
# Auto-regenerate briefing.md, focus.md, and inbound.json when inputs are stale

if [ -z "${SKIP_ARTIFACT_REGEN:-}" ]; then
    echo "🔍 Gate 20: Checking agent context artifacts..."
    
    # Only run if backbone files were staged (indicating docs changed)
    STAGED_BACKBONE=$(git diff --name-only --cached 2>/dev/null | grep -E '^backbone/' || true)
    if [ -n "$STAGED_BACKBONE" ]; then
        ARTIFACTS_CHANGED=0
        
        # briefing.md: regenerate if 3-TASKS.md, 4-KNOWLEDGE.md, 5-DECISIONS.md, or 9-AGENT-SKILLS.md changed
        if echo "$STAGED_BACKBONE" | grep -qE 'backbone/(3-TASKS|4-KNOWLEDGE|5-DECISIONS|9-AGENT-SKILLS)\.md'; then
            if [ -x "$PROJECT_ROOT/scripts/generate-briefing.sh" ]; then
                bash "$PROJECT_ROOT/scripts/generate-briefing.sh" > /tmp/briefing-gen.out 2>&1
                if git diff --quiet "backbone/briefing.md" 2>/dev/null; then
                    : # No change
                else
                    git add "backbone/briefing.md"
                    ARTIFACTS_CHANGED=1
                fi
            fi
        fi
        
        # focus.md: regenerate if 3-TASKS.md changed
        if echo "$STAGED_BACKBONE" | grep -qE 'backbone/3-TASKS\.md'; then
            if [ -x "$PROJECT_ROOT/scripts/generate-focus.sh" ]; then
                bash "$PROJECT_ROOT/scripts/generate-focus.sh" > /tmp/focus-gen.out 2>&1
                if git diff --quiet "backbone/focus.md" 2>/dev/null; then
                    : # No change
                else
                    git add "backbone/focus.md"
                    ARTIFACTS_CHANGED=1
                fi
            fi
        fi
        
        # inbound.json: regenerate if any .md or .sh files changed
        if echo "$STAGED_BACKBONE" | grep -qE '\.(md|sh)$'; then
            if [ -x "$PROJECT_ROOT/scripts/generate-inbound-index.sh" ]; then
                bash "$PROJECT_ROOT/scripts/generate-inbound-index.sh" > /tmp/inbound-gen.out 2>&1
                if git diff --quiet "backbone/index/inbound.json" 2>/dev/null; then
                    : # No change
                else
                    git add "backbone/index/inbound.json"
                    ARTIFACTS_CHANGED=1
                fi
            fi
        fi
        
        if [ "$ARTIFACTS_CHANGED" -eq 1 ]; then
            echo "  🔄 Regenerated agent context artifacts (briefing.md, focus.md, inbound.json)"
        fi
    fi
fi

# ── Gate 21: AC Test Coverage Gate ─────────────────────────────────────────
# Warn if acceptance criteria in traceability YAML lack test references

if [ -z "${SKIP_AC_CHECK:-}" ] && [ -x "$PROJECT_ROOT/scripts/verify-ac-tests.sh" ]; then
    echo "🔍 Gate 21: Checking AC test coverage..."
    if ! bash "$PROJECT_ROOT/scripts/verify-ac-tests.sh" > /tmp/ac-check.out 2>&1; then
        cat /tmp/ac-check.out
        WARNINGS=$((WARNINGS + 1))
    fi
fi

# ── Summary ───────────────────────────────────────────────────────────────

if [ $ERRORS -gt 0 ]; then
    echo -e "\n${RED}❌ Pre-commit check FAILED with $ERRORS error(s)${NC}"
    echo "   Fix errors above, then retry git commit."
    exit 1
fi

if [ $WARNINGS -gt 0 ]; then
    echo -e "\n${YELLOW}⚠️  Pre-commit check passed with $WARNINGS warning(s)${NC}"
else
    echo -e "\n${GREEN}✅ All pre-commit gates passed${NC}"
fi

exit 0
