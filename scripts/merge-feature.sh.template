#!/bin/bash
# scripts/merge-feature.sh
# Merges the current worktree feature branch back to dev and cleans up.
# Intended to be run from within a worktree.
#
# Usage:
#   cd ../my-project-feat-name
#   bash scripts/merge-feature.sh

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

echo -e "${BLUE}🌳 Merging feature to dev...${NC}"
echo ""

# Verify we're in a git repo
if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo -e "${RED}❌ Not in a git repository${NC}"
    exit 1
fi

# Verify we're in a worktree (not the main working tree)
GIT_DIR=$(git rev-parse --git-dir 2>/dev/null || true)
if [[ "$GIT_DIR" != *"worktrees"* ]]; then
    echo -e "${YELLOW}⚠️  You are NOT in a worktree.${NC}"
    echo "   This script is designed to be run from a feature worktree."
    echo ""
    echo "   To merge from the main working tree:"
    echo "     git checkout dev"
    echo "     git merge <feature-branch>"
    exit 1
fi

FEATURE_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
WORKTREE_PATH=$(git rev-parse --show-toplevel 2>/dev/null || true)

echo "  Feature branch: $FEATURE_BRANCH"
echo "  Worktree path:  $WORKTREE_PATH"
echo ""

# Check for uncommitted changes
if ! git diff --quiet HEAD 2>/dev/null || ! git diff --cached --quiet HEAD 2>/dev/null; then
    echo -e "${YELLOW}⚠️  Uncommitted changes detected.${NC}"
    echo "   Commit or stash before merging:"
    echo "     git add -A && git commit -m 'feat(...): final changes'"
    exit 1
fi

# Step 1: Run tests
echo -e "${BLUE}Step 1/4: Running tests...${NC}"
if [ -f "$PROJECT_DIR/gradlew" ]; then
    cd "$PROJECT_DIR"
    if ./gradlew test >/dev/null 2>&1; then
        echo -e "  ✅ Tests passed"
    else
        echo -e "  ${RED}❌ Tests failed. Fix before merging.${NC}"
        exit 1
    fi
elif [ -f "$PROJECT_DIR/pom.xml" ]; then
    cd "$PROJECT_DIR"
    if ./mvnw test >/dev/null 2>&1 || mvn test >/dev/null 2>&1; then
        echo -e "  ✅ Tests passed"
    else
        echo -e "  ${RED}❌ Tests failed. Fix before merging.${NC}"
        exit 1
    fi
else
    echo -e "  ${YELLOW}⚠️  No test runner detected (gradlew/mvnw not found)${NC}"
    echo -n "   Continue without tests? [y/N] "
    read -r response
    if [[ ! "$response" =~ ^[Yy]$ ]]; then
        exit 1
    fi
fi

# Step 2: Update 3-TASKS.md
echo -e "${BLUE}Step 2/4: Marking task complete...${NC}"
TASKS_FILE="$PROJECT_DIR/backbone/3-TASKS.md"
if [ -f "$TASKS_FILE" ]; then
    # Find and mark WIP tasks as completed
    if grep -q '\[WIP\]' "$TASKS_FILE" 2>/dev/null; then
        # Create temp file with WIP -> completed
        sed 's/\[WIP\]/[x]/g' "$TASKS_FILE" > "$TASKS_FILE.tmp"
        mv "$TASKS_FILE.tmp" "$TASKS_FILE"
        echo -e "  ✅ Marked WIP tasks as [x] in 3-TASKS.md"
    else
        echo -e "  ℹ️  No WIP tasks found in 3-TASKS.md"
    fi
else
    echo -e "  ${YELLOW}⚠️  3-TASKS.md not found${NC}"
fi

# Commit the task update
if ! git diff --quiet HEAD 2>/dev/null || ! git diff --cached --quiet HEAD 2>/dev/null; then
    git add -A
    git commit -m "docs(tasks): mark feature tasks as completed" >/dev/null 2>&1 || true
    echo -e "  ✅ Committed task updates"
fi

# Step 3: Merge to dev
echo -e "${BLUE}Step 3/4: Merging to dev branch...${NC}"

# Find the main worktree path
MAIN_WORKTREE=$(git worktree list | grep "$(git rev-parse --show-toplevel | xargs dirname)" | grep -v "worktrees" | awk '{print $1}' | head -1)
if [ -z "$MAIN_WORKTREE" ]; then
    # Fallback: find worktree with main/master/dev checked out
    MAIN_WORKTREE=$(git worktree list | awk '{print $1}' | head -1)
fi

if [ ! -d "$MAIN_WORKTREE" ]; then
    echo -e "${RED}❌ Cannot find main worktree${NC}"
    exit 1
fi

cd "$MAIN_WORKTREE"

# Ensure dev branch exists
git fetch origin dev 2>/dev/null || true
if ! git show-ref --verify --quiet refs/heads/dev; then
    if git show-ref --verify --quiet refs/remotes/origin/dev; then
        git checkout -b dev origin/dev
    else
        git checkout -b dev
    fi
fi

git checkout dev

# Merge the feature branch
echo "  Merging $FEATURE_BRANCH into dev..."
if git merge --no-ff "$FEATURE_BRANCH" -m "merge($FEATURE_BRANCH): integrate feature" 2>/dev/null; then
    echo -e "  ✅ Merged $FEATURE_BRANCH into dev"
else
    echo -e "  ${RED}❌ Merge failed. Resolve conflicts manually:${NC}"
    echo "     cd $MAIN_WORKTREE"
    echo "     git status"
    exit 1
fi

# Step 4: Clean up worktree
echo -e "${BLUE}Step 4/4: Cleaning up worktree...${NC}"

# Push dev (optional - ask first)
echo ""
echo -n "Push dev branch to origin? [y/N] "
read -r push_response
if [[ "$push_response" =~ ^[Yy]$ ]]; then
    if git push origin dev 2>/dev/null; then
        echo -e "  ✅ Pushed dev to origin"
    else
        echo -e "  ${YELLOW}⚠️  Push failed (check auth/remote)${NC}"
    fi
else
    echo -e "  ℹ️  Skipped push. Push manually when ready:"
    echo "     cd $MAIN_WORKTREE"
    echo "     git push origin dev"
fi

# Remove worktree
echo ""
echo -n "Remove worktree '$WORKTREE_PATH'? [Y/n] "
read -r remove_response
if [[ ! "$remove_response" =~ ^[Nn]$ ]]; then
    if command -v wt &> /dev/null; then
        wt remove "$FEATURE_BRANCH" 2>/dev/null || git worktree remove "$WORKTREE_PATH" 2>/dev/null || true
    else
        git worktree remove "$WORKTREE_PATH" 2>/dev/null || true
    fi
    echo -e "  ✅ Removed worktree"
    echo ""
    echo -e "${GREEN}╔════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║  Feature merged and worktree cleaned up! 🎉               ║${NC}"
    echo -e "${GREEN}╚════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo "  Next steps:"
    echo "    cd $MAIN_WORKTREE"
    echo ""
else
    echo -e "  ℹ️  Worktree kept at: $WORKTREE_PATH"
    echo ""
    echo -e "${GREEN}╔════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║  Feature merged to dev! 🎉                                ║${NC}"
    echo -e "${GREEN}╚════════════════════════════════════════════════════════════╝${NC}"
fi

echo ""
echo "  Remember to update backbone documentation:"
echo "    - backbone/5-DECISIONS.md (if architectural decisions made)"
echo "    - backbone/6-MEMORY.md (if insights/pitfalls discovered)"
echo ""
