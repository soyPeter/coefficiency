flowchart TB
    subgraph app[Application Layer]
        direction TB
        UC[Use Cases<br/>app/*UseCase.java]
    end
    
    subgraph infra[Infrastructure Layer]
        direction TB
        REST[REST Controllers<br/>infra/io/rest/]
        JDBI[JDBI Repositories<br/>infra/data/persistence/sql/]
        Events[Event Listeners<br/>infra/io/events/]
        Config[Configuration<br/>infra/config/]
        DTO[DTOs<br/>infra/data/dto/]
    end
    
    subgraph domain[Domain Layer]
        direction TB
        Entity[Entities<br/>domain/model/entity/]
        VO[Value Objects<br/>domain/model/vo/]
        Repo[Repository Ports<br/>domain/actions/]
        Event[Domain Events<br/>domain/event/]
    end
    
    REST --> UC
    Events --> UC
    UC --> Repo
    UC --> Event
    UC --> DTO
    JDBI -.implements.-> Repo
    
    style domain fill:#e8f5e9
    style app fill:#fff3e0
    style infra fill:#e3f2fd
